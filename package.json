    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "lz-string": "^1.5.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
